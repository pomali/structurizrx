{
  "name": "structurizr-dsl",
  "displayName": "StructurizrX DSL",
  "description": "Rich language support for the Structurizr DSL: diagnostics, hover, completion, go-to-definition, find references, rename, semantic highlighting and outline — no binary install required.",
  "version": "0.3.0",
  "private": true,
  "publisher": "structurizrx",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pomali/structurizrx.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/pomali/structurizrx/issues"
  },
  "homepage": "https://github.com/pomali/structurizrx/tree/main/editors/vscode#readme",
  "keywords": [
    "structurizr",
    "structurizrx",
    "c4sx",
    "c4",
    "c4 model",
    "architecture",
    "diagram",
    "dsl",
    "language server",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:structurizr-dsl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "structurizr-dsl",
        "aliases": [
          "Structurizr DSL"
        ],
        "extensions": [
          ".dsl",
          ".c4sx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "structurizr-dsl",
        "scopeName": "source.structurizr-dsl",
        "path": "./syntaxes/structurizr-dsl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Structurizr DSL",
      "properties": {
        "structurizrDsl.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "binary",
            "wasm"
          ],
          "enumDescriptions": [
            "Use the structurizrx binary if one is found, otherwise the bundled WebAssembly server.",
            "Only use the structurizrx binary; report an error if it isn't found.",
            "Always use the bundled WebAssembly server, even if a binary is installed."
          ],
          "default": "auto",
          "description": "How to run the language server. The bundled WebAssembly build needs nothing installed; the native binary is faster and always matches your installed CLI."
        },
        "structurizrDsl.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the structurizrx binary. Leave empty to look it up on PATH (build it with `cargo build -p structurizr-cli` in the repo's rust/ directory). Ignored when structurizrDsl.runtime is \"wasm\"."
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../../rust/structurizr-lsp-wasm --release --target nodejs --out-dir ../../editors/vscode/wasm --out-name structurizr_lsp_wasm",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run build:wasm && npm run compile",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "vscode-jsonrpc": "^9.0.0",
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.91.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.9.2"
  }
}
