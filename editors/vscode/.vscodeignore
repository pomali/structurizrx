# The extension is bundled by esbuild into out/extension.js, so the runtime
# dependencies are already inlined and node_modules has nothing left to ship.
# The one exception is wasm/, which stays as loose files (see esbuild.js).
node_modules/**
wasm/*.d.ts
wasm/package.json
wasm/.gitignore
