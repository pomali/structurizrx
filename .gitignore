# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

.idea
.structurizr
target
*/target
*/build

# WASM files generated by wasm-pack during cargo build
rust/structurizr-web/assets/wasm/

# mdBook output, built with `mdbook build site`
site/book/

# Example diagrams, regenerated from site/examples/*.dsl by
# site/render-examples.sh (or site/build.sh)
site/src/images/

structurizr-*.json
structurizr-application/src/main/resources/static/static/workspace.js

structurizr-application/extensions

# Ignore Gradle local state folders everywhere
**/.gradle/

# VS Code extension (editors/vscode) build output and npm deps
editors/vscode/node_modules/
editors/vscode/out/
# WASM language server, generated by `npm run build:wasm`
editors/vscode/wasm/
*.vsix

# The grammar file matches the structurizr-*.json ignore rule above; keep it.
!editors/vscode/syntaxes/*.json

# Claude Code local state and worktrees
.claude/

# Playwright MCP scratch output (page snapshots, console logs)
.playwright-mcp/

.DS_Store
